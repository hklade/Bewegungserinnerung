{
  "name": "bewegungserinnerung-react-webapp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "dev:test": "node scripts/dev-test-server.mjs",
    "build": "vite build --configLoader runner",
    "preview": "vite preview",
    "test:server": "node scripts/test-server.mjs",
    "test:unit": "vitest run",
    "test:e2e": "node scripts/test-e2e-with-allure.mjs",
    "test:e2e:plain": "playwright test --config config/test.playwright.config.ts",
    "test:e2e:headed": "playwright test --config config/test.playwright.config.ts --headed",
    "test:e2e:dev": "playwright test --config dev.playwright.config.ts",
    "test:e2e:coverage": "rimraf coverage .nyc_output && cross-env COVERAGE=true VITE_COVERAGE=true playwright test --config config/test.playwright.config.ts && node scripts/test-e2e-coverage-report.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-code": "^2.1.234",
    "child_process": "^1.0.2",
    "fs": "^0.0.1-security",
    "path": "^0.12.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.10.2",
    "c8": "^12.0.0",
    "chalk": "^5.6.2",
    "cross-env": "^10.1.0",
    "csv-parse": "^7.0.1",
    "dotenv": "^17.4.2",
    "nyc": "^18.0.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.8.3",
    "vite": "^7.0.4",
    "vite-plugin-istanbul": "^9.0.1",
    "vitest": "^4.1.11"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.62.4",
    "@rollup/rollup-win32-x64-gnu": "4.62.4"
  }
}
